# Operations allowed to break a client in this commit (INFRA-021), one per line:
#
#   METHOD /api/v1/path   # SPEC-KEY why the old shape cannot stay
#
# The gate's contract stage reads it against HEAD's docs/openapi.json. Empty the file once the
# change is committed: an entry left here would let the next break through unreviewed.
POST /api/v1/inventory/movements  # INV-020 a malformed id or unknown type used to answer 500 from the SP; only the web sends it, with real ids and the seven types
POST /api/v1/inventory/reserve  # INV-020 same: a malformed product_id answered 500 before
POST /api/v1/inventory/release-reserved  # INV-020 same: a malformed product_id answered 500 before
