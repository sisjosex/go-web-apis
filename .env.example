# =============================================================================
# CORE MODULE - Application & Database
# =============================================================================

# App mode: debug or release
APP_MODE=debug

# App host and port
APP_HOST=127.0.0.1
APP_PORT=8080

# Database configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/web?sslmode=disable
DATABASE_POOL_SIZE=10

# Enabled modules (comma-separated): core,auth,users
# Comment out modules you want to disable (migrations won't run)
ENABLED_MODULES=core,auth,users

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# AUTH MODULE - Authentication & Sessions
# =============================================================================

# JWT secret keys (CHANGE THESE IN PRODUCTION!)
JWT_SECRET_
JWT_REFRESH_

# JWT token expiration
# Supports time.Duration format: 15m, 1h, 24h, etc.
# Or just numbers (treated as minutes for backward compatibility)
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_HOURS=168  # 7 days

# Email verification
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
EMAIL_VERIFICATION_REQUIRED=false  # Set to true to require email verification

# Password reset
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1

# Session management
MAX_SESSIONS_PER_USER=5

# OAuth providers
ENABLE_FACEBOOK_AUTH=true
ENABLE_GOOGLE_AUTH=false

# SMTP configuration (for password reset & email verification)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pillarsoft.com

# =============================================================================
# USERS MODULE - User Management (Admin)
# =============================================================================

# Pagination defaults
USERS_DEFAULT_PAGE_SIZE=10
USERS_MAX_PAGE_SIZE=100

# User management options
ALLOW_USER_DELETION=true     # Allow hard deletion
ENABLE_SOFT_DELETE=true      # Use soft delete by default

# =============================================================================
# DOCKER - PostgreSQL Container (for local development)
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=web
POSTGRES_PORT=5434
