# =============================================================================
# ENVIRONMENT CONFIGURATION - Two-App Architecture
# =============================================================================
#
# This project uses TWO applications:
# 1. PLATFORM APP (Admin) - runs on port 8080
# 2. TENANT APP (Business) - runs on port 9080
#
# See ARCHITECTURE.md for full documentation
#
# Usage:
#   Platform: go run ./cmd/server -mode=platform
#   Tenant:   go run ./cmd/server -mode=tenant
#   Both:     docker compose up
#

# =============================================================================
# PLATFORM APP CONFIGURATION (.env.platform)
# =============================================================================
# 
# Platform handles: Authentication, User Management, Tenant Management
# Modules: core, auth, users, tenancy
# Database: Main database (shared across all users/tenants)
# Port: 8080
#

# Copy .env.platform to set up Platform App
# Modify DATABASE_URL to point to your main database
# Ensure all AUTH secrets are strong in production


# =============================================================================
# TENANT APP CONFIGURATION (.env.tenant)
# =============================================================================
#
# Tenant handles: Business Operations (Tracking, Invoicing, etc)
# Modules: core, tracking (+ others as you add)
# Database: Per-tenant database (separate instance per customer)
# Port: 9080
#

# Copy .env.tenant to set up Tenant App
# DATABASE_URL should point to tenant-specific database
# Each tenant gets its own database for complete data isolation


# =============================================================================
# DOCKER COMPOSE
# =============================================================================
#
# docker-compose.yml automatically uses:
#   - .env.platform  (Platform service with PostgreSQL on :5432)
#   - .env.tenant    (Tenant service with PostgreSQL on :5433)
#
# Run: docker-compose up
#


# =============================================================================
# KEY DIFFERENCES
# =============================================================================
#
# PLATFORM (.env.platform):
#   - ENABLED_MODULES=core,auth,tenancy,users
#   - APP_PORT=8080
#   - DATABASE_URL=[main database]
#   - Contains: JWT secrets, SMTP config, User settings
#
# TENANT (.env.tenant):
#   - ENABLED_MODULES=core,tracking
#   - APP_PORT=9080
#   - DATABASE_URL=[tenant-specific database]
#   - No auth module (uses JWT from Platform)
#   - Minimal configuration (tracking-specific)


# =============================================================================
# FILES YOU NEED
# =============================================================================
#
# ✅ .env.platform
#    - Rename from .env.platform if needed
#    - Update DATABASE_URL for your main database
#    - Keep JWT secrets secure in production
#
# ✅ .env.tenant
#    - Rename from .env.tenant if needed
#    - Update DATABASE_URL for tenant database
#    - Minimal secrets needed
#
# ❌ DO NOT USE:
#    - .env (deprecated, use .env.platform or .env.tenant)
#    - .env.docker (deprecated, docker-compose.yml handles this)
#    - .env.example (this file - for reference only)
#    - .env.sample-* (deprecated)


# =============================================================================
# COMMON CONFIGURATION TEMPLATES
# =============================================================================
#
# LOCAL DEVELOPMENT:
#   Platform DB: postgres://postgres:postgres@localhost:5432/web
#   Tenant DB:   postgres://postgres:postgres@localhost:5433/tenant_db
#
# DOCKER COMPOSE:
#   Platform DB: postgres://postgres:postgres@platform-db:5432/web
#   Tenant DB:   postgres://postgres:postgres@tenant-db:5432/tenant_db
#
# PRODUCTION:
#   Platform DB: postgres://user:STRONG_PASS@db-platform.company.com:5432/web
#   Tenant DB:   postgres://user:STRONG_PASS@db-tenant.company.com:5432/acme_corp
#



# =============================================================================
# RUNTIME ROLES, VALKEY AND JOBS (INFRA-001) — .env.platform / .env.tenant
# =============================================================================
#
# One binary; -role (or APP_ROLE) picks what a process runs:
#   all        api, plus worker and scheduler in platform mode (default)
#   api        the REST API only
#   worker     asynq handlers + the outbox relay (platform mode)
#   scheduler  periodic tasks, fired only by the lease holder (platform mode)
#   realtime   tenant mode; the WebSocket gateway GET /api/v1/tracking/ws (TRACK-025)
# Without REDIS_URL, `all` runs the API alone with the in-memory rate limit;
# worker and scheduler refuse to start. Valkey down never stops the API: the
# rate limit fails open and /readyz answers 200 "degraded".
#
# REDIS_URL=redis://127.0.0.1:6379/0      # local: 127.0.0.1, not localhost
# REDIS_URL=redis://:VALKEY_PASSWORD@valkey:6379/0   # docker-compose.prod.yml
# APP_ROLE=all
# JOBS_CONCURRENCY=10                     # worker goroutines
# OUTBOX_POLL_INTERVAL=5s                 # relay fallback when a NOTIFY is missed


# =============================================================================
# SETTINGS: core.settings TABLE FIRST, THESE VARS AS FALLBACK
# =============================================================================
#
# Configuration is addressed as <module>.<section>.<key>. Each value is resolved
# in this order:
#   1. the core.settings row (module, section, key)  — loaded once at boot
#   2. the environment variable <MODULE>_<SECTION>_<KEY>  — listed below
#   3. the default compiled into the module's config
#
# Setting a row in core.settings needs no redeploy of the env file:
#   INSERT INTO core.settings (module, section, key, value)
#   VALUES ('import', 'images', 'max_zip_mb', '50');
#
# --- core.media --- (stored files; MEDIA_ROOT must be a volume that survives a
#     redeploy, and must sit outside the build context)
# CORE_MEDIA_ROOT=./storage/media
# CORE_MEDIA_PUBLIC_BASE_URL=http://localhost:8080
#
# --- import.images --- (companion ZIP uploaded alongside an import CSV)
# IMPORT_IMAGES_MAX_ZIP_MB=20
# IMPORT_IMAGES_MAX_IMAGE_KB=2048
# IMPORT_IMAGES_ALLOWED_FORMATS=jpg,jpeg,png,gif
#
# --- geo --- (INFRA-003; .env.tenant only — geo runs on the tenant server)
#     Add `geo` to ENABLED_MODULES. Valhalla down: /geo/route answers 503,
#     /geo/eta falls back to straight line × 1.3 at the speed below.
# GEO_VALHALLA_URL=http://127.0.0.1:8002   # docker-compose.prod.yml: http://valhalla:8002
# GEO_TIMEOUT=5s
# GEO_FALLBACK_SPEED_KMH=25
#
# --- tracking documents --- (compliance scans: insurance, inspections, licences)
#     Deliberately NOT under MEDIA_ROOT: a licence scan is not public content and
#     is only reachable through GET /tracking/documents/:id/file, behind auth.
#     Must be a volume that survives a redeploy. Accepted: pdf, jpg, png.
# TRACKING_DOCUMENTS_ROOT=./storage/tracking-documents
# TRACKING_MAX_DOCUMENT_KB=5120
#
# --- tracking GPS --- (TRACK-010: POST /tracking/ingest/positions → stream → worker)
#     Each tenant's stream gps:{tenant} is trimmed to about MAXLEN points. A point
#     within the radius of the trip's next stop marks it arrived. Partitions older
#     than the retention are dropped nightly (01:00 UTC).
# GPS_STREAM_MAXLEN=100000
# GPS_ARRIVAL_RADIUS_M=50
# TRACKING_LOCATION_RETENTION_DAYS=90
#
# --- tracking realtime --- (TRACK-025: the WebSocket gateway, roles all and realtime)
#     A ping every WS_PING_SECONDS (no pong → closed); a connection closed 1013
#     once WS_QUEUE_MAX frames that must all arrive are waiting for it.
# WS_PING_SECONDS=25
# WS_QUEUE_MAX=64
#
# --- tracking notices --- (TRACK-012: feed rows always, pushes through FCM HTTP v1)
#     Trip events (start, approaching, boarded, dropped off, no-show, cancelled,
#     changed) and raised alerts (delay) become a feed row per guardian; each flag
#     turns its half off. A trip announces a stop once, the first time the vehicle
#     is within the approach radius of it. Without FCM_PROJECT_ID and a service-
#     account key (Firebase console → Project settings → Service accounts) notices
#     stay in the feed only; iOS needs the APNs key uploaded to that project.
# TRACKING_ENABLE_REALTIME_NOTIFICATIONS=true
# TRACKING_ENABLE_ALERT_NOTIFICATIONS=true
# TRACKING_APPROACH_RADIUS_M=800
# FCM_PROJECT_ID=my-firebase-project
# FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json


# =============================================================================
# DEPLOY — docker-compose.prod.yml
# =============================================================================
#
# These go in a `.env` file beside docker-compose.prod.yml (compose reads it
# automatically). The per-server settings stay in .env.platform / .env.tenant,
# whose DATABASE_URL must point at the `postgres` service, not at localhost:
#
#   DATABASE_URL=postgres://postgres:STRONG_PASS@postgres:5432/web?sslmode=disable
#
# .env.tenant also needs JWT_SECRET_KEY and JWT_REFRESH_KEY — it enables the
# auth module to validate the tokens the platform issues, so both files must
# carry the same pair. Without them the tenant server panics at startup.
#
#   docker compose -f docker-compose.prod.yml up -d --build
#
# --- PostgreSQL container ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=STRONG_PASS
# POSTGRES_DB=web                 # the platform database
# TENANT_POSTGRES_DB=tenant_db    # the tenant server's own database; nothing in
#                                 # the API issues CREATE DATABASE, so the
#                                 # postgres init script creates it on first boot
#
# --- Valkey (queues, rate limit) ---
# VALKEY_PASSWORD=STRONG_PASS     # the same password goes in REDIS_URL in
#                                 # .env.platform and .env.tenant
#
# --- Caddy (TLS is automatic; only 80/443 are published) ---
# PLATFORM_HOST=api.example.com
# TENANT_HOST=tenant.example.com
# ACME_EMAIL=ops@example.com
#
# --- API image tag ---
# API_TAG=latest
#
# --- Nightly backup (docker/backup/README.md has the restore steps) ---
# BACKUP_SCHEDULE=0 3 * * *       # crontab line, UTC
# BACKUP_KEEP_DAYS=14
# BACKUP_S3_BUCKET=xanthops-backups
# BACKUP_S3_ENDPOINT=             # MinIO / R2 / Spaces; empty = real AWS S3
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=us-east-1
#
# --- Geo (INFRA-003) — docker/geo/README.md ---
# GEO_DATA_DIR=/srv/geo            # builds live here: current/, previous/, <date>/;
#                                  # valhalla and Caddy (TENANT_HOST/tiles/) read it
# Build machine only (docker/geo/build.sh), never needed on the server:
# GEO_REGIONS=south-america/bolivia          # Geofabrik paths, comma-separated
# TILES_URL=https://tenant.example.com/tiles # baked into the styles
