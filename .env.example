# =============================================================================
# ENVIRONMENT CONFIGURATION - Two-App Architecture
# =============================================================================
#
# This project uses TWO applications:
# 1. PLATFORM APP (Admin) - runs on port 8080
# 2. TENANT APP (Business) - runs on port 9080
#
# See ARCHITECTURE.md for full documentation
#
# Usage:
#   Platform: go run ./cmd/platform
#   Tenant:   go run ./cmd/tenant
#   Both:     docker-compose up
#

# =============================================================================
# PLATFORM APP CONFIGURATION (.env.platform)
# =============================================================================
# 
# Platform handles: Authentication, User Management, Tenant Management
# Modules: core, auth, users, tenancy
# Database: Main database (shared across all users/tenants)
# Port: 8080
#

# Copy .env.platform to set up Platform App
# Modify DATABASE_URL to point to your main database
# Ensure all AUTH secrets are strong in production


# =============================================================================
# TENANT APP CONFIGURATION (.env.tenant)
# =============================================================================
#
# Tenant handles: Business Operations (Tracking, Invoicing, etc)
# Modules: core, tracking (+ others as you add)
# Database: Per-tenant database (separate instance per customer)
# Port: 9080
#

# Copy .env.tenant to set up Tenant App
# DATABASE_URL should point to tenant-specific database
# Each tenant gets its own database for complete data isolation


# =============================================================================
# DOCKER COMPOSE
# =============================================================================
#
# docker-compose.yml automatically uses:
#   - .env.platform  (Platform service with PostgreSQL on :5432)
#   - .env.tenant    (Tenant service with PostgreSQL on :5433)
#
# Run: docker-compose up
#


# =============================================================================
# KEY DIFFERENCES
# =============================================================================
#
# PLATFORM (.env.platform):
#   - ENABLED_MODULES=core,auth,users,tenancy
#   - APP_PORT=8080
#   - DATABASE_URL=[main database]
#   - Contains: JWT secrets, SMTP config, User settings
#
# TENANT (.env.tenant):
#   - ENABLED_MODULES=core,tracking
#   - APP_PORT=9080
#   - DATABASE_URL=[tenant-specific database]
#   - No auth module (uses JWT from Platform)
#   - Minimal configuration (tracking-specific)


# =============================================================================
# FILES YOU NEED
# =============================================================================
#
# ✅ .env.platform
#    - Rename from .env.platform if needed
#    - Update DATABASE_URL for your main database
#    - Keep JWT secrets secure in production
#
# ✅ .env.tenant
#    - Rename from .env.tenant if needed
#    - Update DATABASE_URL for tenant database
#    - Minimal secrets needed
#
# ❌ DO NOT USE:
#    - .env (deprecated, use .env.platform or .env.tenant)
#    - .env.docker (deprecated, docker-compose.yml handles this)
#    - .env.example (this file - for reference only)
#    - .env.sample-* (deprecated)


# =============================================================================
# COMMON CONFIGURATION TEMPLATES
# =============================================================================
#
# LOCAL DEVELOPMENT:
#   Platform DB: postgres://postgres:postgres@localhost:5432/web
#   Tenant DB:   postgres://postgres:postgres@localhost:5433/tenant_db
#
# DOCKER COMPOSE:
#   Platform DB: postgres://postgres:postgres@platform-db:5432/web
#   Tenant DB:   postgres://postgres:postgres@tenant-db:5432/tenant_db
#
# PRODUCTION:
#   Platform DB: postgres://user:STRONG_PASS@db-platform.company.com:5432/web
#   Tenant DB:   postgres://user:STRONG_PASS@db-tenant.company.com:5432/acme_corp
#



# =============================================================================
# SETTINGS: core.settings TABLE FIRST, THESE VARS AS FALLBACK
# =============================================================================
#
# Configuration is addressed as <module>.<section>.<key>. Each value is resolved
# in this order:
#   1. the core.settings row (module, section, key)  — loaded once at boot
#   2. the environment variable <MODULE>_<SECTION>_<KEY>  — listed below
#   3. the default compiled into the module's config
#
# Setting a row in core.settings needs no redeploy of the env file:
#   INSERT INTO core.settings (module, section, key, value)
#   VALUES ('import', 'images', 'max_zip_mb', '50');
#
# --- core.media --- (stored files; MEDIA_ROOT must be a volume that survives a
#     redeploy, and must sit outside the build context)
# CORE_MEDIA_ROOT=./storage/media
# CORE_MEDIA_PUBLIC_BASE_URL=http://localhost:8080
#
# --- import.images --- (companion ZIP uploaded alongside an import CSV)
# IMPORT_IMAGES_MAX_ZIP_MB=20
# IMPORT_IMAGES_MAX_IMAGE_KB=2048
# IMPORT_IMAGES_ALLOWED_FORMATS=jpg,jpeg,png,gif
