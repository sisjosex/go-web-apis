# =============================================================================
# CORE MODULE - Application & Database
# =============================================================================

# App mode: debug or release
APP_MODE=debug

# App host and port
APP_HOST=127.0.0.1
APP_PORT=8080

# Database configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/web?sslmode=disable
DATABASE_POOL_SIZE=10

# Enabled modules (comma-separated): core,auth,users,tenancy
ENABLED_MODULES=core,auth,users

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Logging level: debug, info, warn, error
LOG_LEVEL=debug

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# AUTH MODULE - Authentication & Sessions
# =============================================================================

# JWT secret keys (CHANGE THESE IN PRODUCTION!)
JWT_SECRET_
JWT_REFRESH_

# JWT token expiration (supports time.Duration: 15m, 1h, 24h, etc.)
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_HOURS=168  # 7 days

# Email verification
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
EMAIL_VERIFICATION_REQUIRED=false

# Password reset
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1

# Session management
MAX_SESSIONS_PER_USER=5

# OAuth providers
ENABLE_FACEBOOK_AUTH=false
ENABLE_GOOGLE_AUTH=false

# SMTP configuration (for password reset & email verification)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# =============================================================================
# USERS MODULE - User Management (Admin)
# =============================================================================

# Pagination defaults
USERS_DEFAULT_PAGE_SIZE=20
USERS_MAX_PAGE_SIZE=100

# User management options
ALLOW_USER_DELETION=false
ENABLE_SOFT_DELETE=true

# Avatar upload settings
MAX_AVATAR_SIZE_KB=2048  # 2MB
ALLOWED_AVATAR_FORMATS=jpg,jpeg,png,gif

# =============================================================================
# TENANCY MODULE - Multitenancy (Optional)
# =============================================================================

# Enable/disable multitenancy
TENANCY_ENABLED=false

# Database pool size for tenant databases
TENANCY_DATABASE_POOL_SIZE=5

# Allow tenants to use their own database URLs
TENANCY_ALLOW_CUSTOM_DATABASE_URLS=true

# Default schema name for schema-based tenancy (when database_url is NULL)
TENANCY_DEFAULT_SCHEMA=public
