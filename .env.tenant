# =============================================================================
# TENANT API - Business Operations Application
# =============================================================================

# App mode: debug or release
APP_MODE=debug

# Server configuration
APP_HOST=127.0.0.1
APP_PORT=9080

# Frontend URL (used for email links and CORS)
FRONTEND_URL=http://localhost:3001

# Database configuration (typically provided by Platform when creating tenant)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/web4?sslmode=disable
DATABASE_POOL_SIZE=15

# Enabled modules - TENANT ONLY (no tenancy management)
# Tenant databases have their own auth/users (local tenant users)
# Tenancy management stays centralized in Main DB
ENABLED_MODULES=core,auth,users,tracking

# Modules to load but exclude from migrations in this database
# Leave empty - all modules should be migrated in Tenant DBs
EXCLUDED_FROM_MIGRATION=

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# CORS - allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:9080

# =============================================================================
# TRACKING MODULE - Transport Tracking (School & Corporate)
# =============================================================================

# GPS location settings
TRACKING_MAX_LOCATION_BATCH_SIZE=100
TRACKING_LOCATION_RETENTION_DAYS=90
TRACKING_LOCATION_RATE_LIMIT_SEC=5

# Real-time notifications
TRACKING_ENABLE_REALTIME_NOTIFICATIONS=true
TRACKING_NOTIFICATION_DELAY_THRESHOLD=15m

# Alert settings
TRACKING_ALERT_AUTO_RESOLVE_HOURS=24
TRACKING_ENABLE_ALERT_NOTIFICATIONS=true

# Performance settings
TRACKING_ENABLE_LOCATION_PARTITIONING=true
TRACKING_MAX_EVENTS_PER_RIDER=1000

# =============================================================================
# DOCKER - PostgreSQL Container (separate from Platform)
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tenant_db
POSTGRES_PORT=5433
